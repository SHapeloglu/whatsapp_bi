# ══════════════════════════════════════════════════════
#  WhatsApp BI — Ortam Değişkenleri
#  Contabo sunucusunda /home/openpyerp/whatsapp_bi/.env
# ══════════════════════════════════════════════════════

# ── OpenPyERP API ──────────────────────────────────────
# Flask uygulaması aynı sunucuda çalışıyorsa localhost
OPENPYERP_API_URL=http://localhost:5000
OPENPYERP_EMAIL=admin@firma.com
OPENPYERP_SIFRE=guclu_bir_sifre

# API Key kullanmak istersen (JWT yerine):
# OPENPYERP_API_KEY=buraya_api_key

# ── Meta WhatsApp ──────────────────────────────────────
# Meta Developer Console → App → WhatsApp → API Setup
WA_TOKEN=EAAxxxx...
WA_PHONE_ID=1221514654368217
WA_VERIFY_TOKEN=openpyerp_verify_2026   # İstediğin herhangi bir kelime

# Meta App → Settings → Basic → App Secret (webhook HMAC; boşsa webhook POST reddedilir)
WA_APP_SECRET=

# ── Yönetim uçları ─────────────────────────────────────
# X-API-Key başlığıyla gönderilir; üret: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ── NLP / LLM Fallback (opsiyonel) ────────────────────
# Regex çözemeyen sorgular için Claude Haiku
# ANTHROPIC_API_KEY=sk-ant-xxxx

# ── Veritabanı ─────────────────────────────────────────
# OpenPyERP'nin PostgreSQL bağlantısı
DATABASE_URL=postgresql+psycopg2://openpyerp_user:sifre@localhost/openpyerp_db
